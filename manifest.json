{
  "manifest_version": 3,
  "name": "TogglePlay Debug",
  "version": "1.0.1",
  "description": "Simplified version for debugging YouTube tab sync",
  
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  
  "background": {
    "service_worker": "background_simple.js"
  },
  
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["content_simple.js"],
      "run_at": "document_idle"
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "TogglePlay Debug"
  }
}
