{
  "manifest_version": 3,
  "name": "TogglePlay",
  "version": "2.0.0",
  "version_name": "2.0.0-beta.1",
  "description": "Automatically toggles play/pause between YouTube, YouTube Music, and Spotify tabs for seamless media experience",

  "permissions": [
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://music.youtube.com/*",
    "https://open.spotify.com/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "src/core/config.js",
        "src/core/messages.js",
        "src/content/lib/context.js",
        "src/content/lib/messaging.js",
        "src/content/lib/keyboard.js",
        "src/content/platforms/youtube/index.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "src/core/config.js",
        "src/core/messages.js",
        "src/content/lib/context.js",
        "src/content/lib/messaging.js",
        "src/content/lib/keyboard.js",
        "src/content/platforms/ytmusic/index.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "src/core/config.js",
        "src/core/messages.js",
        "src/content/lib/context.js",
        "src/content/lib/messaging.js",
        "src/content/lib/keyboard.js",
        "src/content/platforms/spotify/index.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },

  "action": {
    "default_popup": "src/ui/popup/popup.html",
    "default_title": "TogglePlay",
    "default_icon": {
      "16": "assets/icon.png",
      "48": "assets/icon.png",
      "128": "assets/icon.png"
    }
  }
}
