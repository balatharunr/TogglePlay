{
  "manifest_version": 3,
  "name": "TogglePlay",
  "version": "1.1.0",
  "description": "Automatically toggles play/pause between YouTube and Spotify tabs for seamless media experience",
  
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://open.spotify.com/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": ["content-spotify.js"],
      "run_at": "document_idle"
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "TogglePlay"
  }
}
